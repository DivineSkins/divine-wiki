# Security + caching headers for STATIC ASSETS ONLY. On Workers static
# assets, _headers never applies to Worker-generated responses (SSR pages,
# /api/*): those get their headers from next.config.mjs headers() or the
# route handlers themselves.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400

# Downloadable wiki files (currently the .rubyshader shaders, which are
# renamed .7z archives). Workers static assets have no MIME mapping for
# these extensions, so responses shipped with no Content-Type at all;
# combined with the nosniff above, browsers rendered the raw archive bytes
# as a page of garbage text instead of downloading. Setting the type and
# forcing attachment makes a click, or a pasted URL, download the file.
/wiki-files/*
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  Cache-Control: public, max-age=86400
